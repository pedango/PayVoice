# Normalise to LF in the repository. The container image builds on Linux, so
# CRLF checked into the tree would break shell invocations and make gofmt
# checks fail in CI on a Windows-authored commit.
* text=auto eol=lf

*.go      text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
Dockerfile text eol=lf
Makefile  text eol=lf
.env.example text eol=lf

# Keep captured media byte-exact.
*.wav  binary
*.pcap binary
