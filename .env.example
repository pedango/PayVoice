# Pedango configuration.
#
# Every value here is a default that already works for local development. The
# ones you must change for production are marked REQUIRED IN PRODUCTION; the
# process refuses to start without them when PEDANGO_ENV=production.
#
# Generate any secret with:  openssl rand -hex 32

# ---------------------------------------------------------------- runtime

# development | production
PEDANGO_ENV=development
# debug | info | warn | error
PEDANGO_LOG_LEVEL=info
# Structured JSON logs, for shipping to a log aggregator.
PEDANGO_LOG_JSON=false

# ---------------------------------------------------------------- control API

# Bind 127.0.0.1 unless the control plane is behind a proxy or private network.
# This API can originate calls, so it must never face the public internet.
PEDANGO_HTTP_ADDR=127.0.0.1:8080

# REQUIRED IN PRODUCTION. Comma-separated bearer tokens, each 32+ characters.
# Rotate by listing both the old and new token, deploying, then removing the old.
PEDANGO_API_TOKENS=

# Optional second layer: only these addresses may reach the control plane.
# Accepts bare addresses and CIDR blocks.
PEDANGO_API_ALLOWED_IPS=

# Only enable behind a proxy you control. It makes the allowlist believe
# X-Forwarded-For, which any caller could otherwise spoof.
PEDANGO_HTTP_TRUST_PROXY=false

# ---------------------------------------------------------------- webhooks

# Where call events are delivered. Must be https in production.
PEDANGO_WEBHOOK_URL=

# REQUIRED IN PRODUCTION when a URL is set. 32+ characters.
# The receiver verifies HMAC-SHA256 over the raw request body.
PEDANGO_WEBHOOK_SECRET=

PEDANGO_WEBHOOK_TIMEOUT=5s
PEDANGO_WEBHOOK_RETRIES=3

# ---------------------------------------------------------------- SIP

# Leave false to run browser-only, which needs no carrier at all.
PEDANGO_SIP_ENABLED=false

PEDANGO_SIP_LISTEN=0.0.0.0:5060
# udp | tcp
PEDANGO_SIP_TRANSPORT=udp

# The address peers should send media to. On a cloud VM this is the public IP,
# NOT the bind address: SDP advertises this value, and advertising a private
# address is the single most common cause of one-way audio.
PEDANGO_SIP_PUBLIC_HOST=

# The SIP domain used in From/To URIs. Defaults to the public host.
PEDANGO_SIP_DOMAIN=

# Where outbound calls are sent, e.g. sip:trunk.carrier.com.gh:5060
PEDANGO_SIP_TRUNK=

# Caller ID presented on outbound calls, e.g. 233245224253
PEDANGO_SIP_IDENTITY=

# Registration, for trunks that require it rather than IP allowlisting.
PEDANGO_SIP_REGISTER=false
PEDANGO_SIP_REGISTRAR=
PEDANGO_SIP_USERNAME=
PEDANGO_SIP_PASSWORD=
PEDANGO_SIP_REGISTER_EXPIRY=300s

# ---------------------------------------------------------------- RTP

PEDANGO_RTP_HOST=0.0.0.0

# Must be an even-sized range: RTP takes the even port, RTCP the odd one above.
# Each concurrent call consumes one pair, so this range caps concurrency.
# Open this whole range UDP inbound on the firewall.
PEDANGO_RTP_PORT_MIN=20000
PEDANGO_RTP_PORT_MAX=20400

# Send media to the address packets actually arrive from rather than the one
# advertised in SDP. Required for essentially every carrier behind NAT.
PEDANGO_RTP_SYMMETRIC=true

# RFC 4733 telephone-event payload type. Pedango echoes the peer's number when
# they offer one, so this is only the fallback.
PEDANGO_RTP_DTMF_PT=101

# ---------------------------------------------------------------- WebRTC

# Comma-separated. A public STUN server is enough on a normal network; add TURN
# for callers behind symmetric NAT or restrictive corporate firewalls.
PEDANGO_ICE_URLS=stun:stun.l.google.com:19302
PEDANGO_TURN_USERNAME=
PEDANGO_TURN_CREDENTIAL=

# Open this range UDP inbound as well.
PEDANGO_WEBRTC_PORT_MIN=40000
PEDANGO_WEBRTC_PORT_MAX=40400

# On a cloud VM the host candidate is a private address no browser can reach.
# Set this to the public IP and Pedango rewrites the candidate.
PEDANGO_WEBRTC_PUBLIC_IP=

# ---------------------------------------------------------------- media

# pcmu (mu-law, North America and most VoIP) | pcma (A-law, Europe and Africa)
# Ghanaian carriers commonly use A-law. Pedango honours whatever the peer
# offers on a per-call basis; this is only the default for calls it originates.
PEDANGO_CODEC=pcmu

# Playout delay held by each receive buffer. Higher survives worse networks at
# the cost of latency. 60ms suits a good link; try 120ms on mobile data.
PEDANGO_JITTER_TARGET=60ms
PEDANGO_JITTER_MAX=240ms

PEDANGO_MAX_LEGS_PER_ROOM=8
PEDANGO_ROOM_IDLE_TIMEOUT=5m

# Hard cap on any single call, a backstop against a carrier that never sends
# BYE and would otherwise leak a leg and its RTP port forever.
PEDANGO_LEG_MAX_DURATION=30m

# Voice activity detection. The threshold is an absolute noise gate in RMS;
# the detector adapts above it. Raise it for noisy GSM lines.
PEDANGO_VAD_THRESHOLD=700
# Trailing silence that closes an utterance.
PEDANGO_END_OF_SPEECH=700ms

# ---------------------------------------------------------------- TTS

# elevenlabs | http | tone | silence
#
# "tone" needs no account and renders text as beeps. Use it to prove the media
# path works before involving any vendor.
PEDANGO_TTS_PROVIDER=tone

PEDANGO_TTS_API_KEY=
PEDANGO_TTS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
PEDANGO_TTS_MODEL=eleven_turbo_v2_5

# For PEDANGO_TTS_PROVIDER=http: a self-hosted engine such as Piper or Coqui.
# Pedango POSTs {text, voice, sample_rate, format} and expects WAV back.
PEDANGO_TTS_BASE_URL=

PEDANGO_TTS_TIMEOUT=10s

# IVR prompts repeat on every call, so caching removes a network round trip
# from the critical path of most conversation turns.
PEDANGO_TTS_CACHE_SIZE=256
PEDANGO_TTS_CACHE_TTL=1h
PEDANGO_TTS_MAX_CHARS=1000

# ---------------------------------------------------------------- STT

# deepgram | none
#
# Leave as none to rely on DTMF, which is the safer input channel for anything
# that moves money: a keypress cannot be misheard.
PEDANGO_STT_PROVIDER=none

PEDANGO_STT_API_KEY=
PEDANGO_STT_MODEL=nova-2-phonecall
PEDANGO_STT_LANGUAGE=en
# Provider-side silence threshold in milliseconds before a result is final.
PEDANGO_STT_ENDPOINTING=300
